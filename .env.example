# ─── Which model answers as Bes ──────────────────────────────────────────────
# auto (default) → Ollama if configured, else Claude, else the canned library.
# Force one with: ollama | anthropic | offline
PISO_AI_PROVIDER=auto

# ─── Ollama ──────────────────────────────────────────────────────────────────
# Your own daemon: the same base URL you use in n8n's Ollama credential.
# Run `npm run ai:check` to confirm the URL and list your installed models.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Only if your Ollama sits behind a proxy that wants a bearer token — or if
# you're on Ollama Cloud, in which case drop OLLAMA_HOST and the model
# defaults to gpt-oss:120b.
# OLLAMA_API_KEY=

# Bes drafts transactions via a tool call, so prefer a tool-capable model
# (qwen2.5:7b, llama3.1:8b, mistral, qwen3…). `ai:check` flags which of yours
# support tools. Without one the server falls back to a local text parser —
# it still works, just rougher.

# Context window. The persona + finance snapshot is ~1k tokens, and Ollama's
# default window is small enough to truncate it. Lower if RAM is tight.
# OLLAMA_NUM_CTX=8192

# ─── Claude (optional; what the original design brief specified) ─────────────
# ANTHROPIC_API_KEY=sk-ant-...
# PISO_MODEL=claude-opus-5

# ─── Server ──────────────────────────────────────────────────────────────────
# PORT=8787
