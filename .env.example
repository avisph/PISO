# ─── Which model answers as Bes ──────────────────────────────────────────────
# auto (default) → Ollama if configured, else Claude, else the canned library.
# Force one with: ollama | anthropic | offline
PISO_AI_PROVIDER=auto

# ─── Ollama ──────────────────────────────────────────────────────────────────
# Ollama Cloud: set the key; the host defaults to https://ollama.com.
OLLAMA_API_KEY=

# Local Ollama instead: leave the key blank and point at your daemon.
# OLLAMA_HOST=http://localhost:11434

# Any tool-calling model. Defaults to gpt-oss:120b when a key is set (cloud),
# llama3.1:8b when it isn't (local). Bes drafts transactions via a tool call,
# so prefer a model that supports tools — the server falls back to a local
# parser when the model doesn't call it, but that parse is much rougher.
# OLLAMA_MODEL=gpt-oss:120b

# ─── Claude (optional; what the original design brief specified) ─────────────
# ANTHROPIC_API_KEY=sk-ant-...
# PISO_MODEL=claude-opus-5

# ─── Server ──────────────────────────────────────────────────────────────────
# PORT=8787
